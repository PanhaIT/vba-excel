Public Sub hideFullfilied()
    Dim ws As Worksheet
    Set ws = ThisWorkbook.Worksheets("SaleInvoiceData")
    If ws.name = "SaleInvoiceData" Then
        ' With ws.Range("Q2").Interior 'inv_status_note = Z7
        '     .ColorIndex = 2
        ' End With
        With ws.Range("Q2").Font
            .Bold = False
            .ColorIndex = 2
            .Name = "Roboto"
            .Size = 20
        End With
        With ws.Range("Q3").Font
