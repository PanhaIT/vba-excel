Public  Sub goDatabaseWorkbook()
    Dim activeWorkbook, wbDatabase As Workbook
    Dim ws_file_setting,ws_print_invoice As Worksheet
    Dim databasePath, databaseFile As String

    Set activeWorkbook  = Workbooks("index.xlsm")
    Set ws_file_setting = activeWorkbook.Sheets("FilesSetting")
    
    If (checkDatabaseFile = TRUE) Then 
        databasePath = ws_file_setting.Range("database_path").Value
        databaseFile = databasePath & "database_kscm.xlsm"

        If (IsWorkbookOpen(databaseFile) = FALSE) Then
            Set wbDatabase = Workbooks.Open(databaseFile)  'add here the path of your text file
        End If
        wbDatabase.Worksheets("Home").Select
    End If
End Sub

Public Sub goInvSalePbWorkbook()
    Dim activeWorkbook, invSalePbWorkbook As Workbook
    Dim ws_file_setting As Worksheet
    Dim invSalePbPath, invSalePbFile As String

    Set activeWorkbook = Workbooks("database_kscm.xlsm")
    Set ws_file_setting = activeWorkbook.Sheets("FilesSetting")
    
    If (checkDatabaseFile = True) Then
        invSalePbPath = ws_file_setting.Range("data_input_path").Value
        invSalePbFile = invSalePbPath & "index.xlsm"

        If (IsWorkbookOpen(invSalePbFile) = False) Then
            Set invSalePbWorkbook = Workbooks.Open(invSalePbFile)  'add here the path of your text file
        End If
        invSalePbWorkbook.Worksheets("Home").Select
    End If
End Sub

Public  Sub goToNBCExchangeRate()
    'Declaring a variable strURL as string to capture the URL
    Dim strURL As String
    
    'Asigning the URL to the Variable created above
    strURL = "https://www.nbc.gov.kh/english/economic_research/exchange_rate.php"
    
    'Opening the URL using FollowHyperlink method of Workbook
    ThisWorkbook.FollowHyperlink (strURL)
End Sub

Public Sub goSelectedSheet()
    Dim invoiceNo As String
    invoiceNo = "(" & Sheets("Home").Range("sheet_invoice_no").Value & ")"
    On Error Resume Next
    If Sheets("" & invoiceNo & "") Is Nothing Then
        MsgBox "Sheet " & invoiceNo & " doesn't exist."
    Else
        Sheets(invoiceNo).Activate
    End If
End Sub

Public Function ThisCell(selectCell) As String
    ThisCell = "ROW:" & Application.Caller.Row & " - COLUMN:" & Application.Caller.Column
    MsgBox "This Cell (Row,Column)= " & ThisCell
End Function

